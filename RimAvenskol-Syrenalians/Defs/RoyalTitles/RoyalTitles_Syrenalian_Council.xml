  <RoyalTitleDef ParentName="BaseSyrenalianHCOccupation">
    <defName>Syrnl_Illiatari</defName>
    <label>illiatari</label>
    <description>The Syrenalian occupation of illiatari is employed by the Council to keep the peace. Most Syrenalian citizens earn it while young through military service. The occupation is also offered to outsiders who act with loyalty in the eyes of The High Council.</description>
    <seniority>0</seniority>
    <favorCost>1</favorCost>
    <changeHeirQuestPoints>1000</changeHeirQuestPoints>
    <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
    <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="BaseSyrenalianHCOccupation">
    <defName>Illiatari_Vexara</defName>
    <label>vexara illiatari</label>
    <description>The Syrenalian occupation of vexara is held in deep respect. It gives the holder the right to use low-level psychic abilities as part of their learning.\n\nThis occupation is often held by senior soldiers, warskiff pilots, spies, advisors, diplomats, intrusion operatives, and other key individuals. Many important people spend their entire lives as novices.</description>
    <seniority>100</seniority>
    <favorCost>6</favorCost>
    <changeHeirQuestPoints>1000</changeHeirQuestPoints>
    <commonality>1</commonality>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="BaseSyrenalianHCOccupation">
