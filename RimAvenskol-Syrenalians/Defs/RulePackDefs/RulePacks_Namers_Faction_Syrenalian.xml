<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RulePackDef>
        <defName>NamerFactionSyrenalian</defName>
        <rulePack>
            <include>
                <li>NamerLastNamesSyrenalian</li>
            </include>
            <rulesStrings>
                <li>r_name->The Axilarium of [canonOrigin]</li>
                <li>r_name->The Axilarium of [randOriginPrefix][randOriginSuffix]</li>
                <li>r_name->The High Council of [canonOrigin]</li>
                <li>r_name->The High Council of [randOriginPrefix][randOriginSuffix]</li>
                <li>r_name->The Unitarium of [canonOrigin]</li>
                <li>r_name->The Unitarium of [randOriginPrefix][randOriginSuffix]</li>
                <!--Canon-->
                <li>canonOrigin->Eilasalia</li>
                <li>canonOrigin->Einfiera</li>
                <li>canonOrigin->Octusaria</li>
                <li>canonOrigin->Syrenalia</li>
                <!--Random-->
                <li>randOriginPrefix->Eilas</li>
                <li>randOriginPrefix->Einf</li>
                <li>randOriginPrefix->Octus</li>
                <li>randOriginPrefix->Syren</li>
                <li>randOriginSuffix->alia</li>
                <li>randOriginSuffix->iera</li>
                <li>randOriginSuffix->aria</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>NamerSettlementSyrenalian</defName>
        <rulePack>
            <rulesStrings>
                <li>r_name->The Hegemon of [lastName]</li>
                <li>r_name->The Hegemon of [element]</li>
                <li>lastName->[lastNamePrefix][lastNameSuffix]</li>
                <!--Dark-->
                <li>lastNamePrefix->Eivi</li>
                <li>lastNamePrefix->Ixyr</li>
                <li>lastNamePrefix->Vana</li>
                <li>lastNamePrefix->Veit</li>
                <li>lastNamePrefix->Vevin</li>
                <li>lastNamePrefix->Vel</li>
                <li>lastNameSuffix->ozal</li>
                <li>lastNameSuffix->tiel</li>
                <li>lastNameSuffix->rix</li>
                <li>lastNameSuffix->astra</li>
                <li>lastNameSuffix->egor</li>
                <li>element->Darkness</li>
                <li>element->Shadows</li>
                <!--Light-->
                <li>lastNamePrefix->Savi</li>
                <li>lastNamePrefix->Xela</li>
                <li>lastNameSuffix->stalus</li>
                <li>lastNameSuffix->stato</li>
                <li>lastNameSuffix->styr</li>
                <li>element->Light</li>
                <li>element->Stars</li>
                <!--Fire-->
                <li>lastNamePrefix->Aeri</li>
                <li>lastNamePrefix->Alva</li>
                <li>lastNamePrefix->Eathyr</li>
                <li>lastNamePrefix->Fie</li>
                <li>lastNamePrefix->Ka</li>
                <li>lastNamePrefix->Kata</li>
                <li>lastNamePrefix->Shavik</li>
                <li>lastNamePrefix->Tal</li>
                <li>lastNamePrefix->Vari</li>
                <li>lastNameSuffix->skala</li>
                <li>lastNameSuffix->neia</li>
                <li>lastNameSuffix->atis</li>
                <li>lastNameSuffix->ra</li>
                <li>lastNameSuffix->ta</li>
                <li>lastNameSuffix->fiera</li>
                <li>lastNameSuffix->samnia</li>
                <li>element->Fire</li>
                <li>element->Suns</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>